-----------------------------------------------sleep
local function sleep(n)
    os.execute("sleep " ..tonumber(n))
end
--------------------wait
function wait(msec)
   local t = os.clock()
   repeat
   until os.clock() > t + msec * 1e-3
end
----------------------------------------------time wait
local function timer(n)
    while n > 0 do
        io.write(ac.cyan.."   ::::: "..ac.yellow.. tonumber(n) ..ac.yellow.." sec "..ac.cyan..":::::\r"..ac.reset)
        sleep(1)
        io.flush()
        n = n-1
    end
end
