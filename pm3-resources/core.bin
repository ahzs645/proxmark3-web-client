local function find( main )
    main = main:lower()
    for k, v in pairs(_names) do
        if ( v[1]:lower() == main ) then
            return v
        end
    end
    return nil
end
local function list()
    print ("Type\tEdition\t Model name")
    print (string.rep('=', 54))
    for k, v in pairs(_names) do
        print(("%s\t%s\t%s"):format(v[1],v[2],v[3] ))
    end
end

return {
    Find = find,
    List = list,
}
