    core.console('lf t55 write -b 0 -d 000880E0 --r2')
    core.console('lf t55 write -b 0 -d 000880E0 --r3')
    core.console('lf t55 wipe')
    core.console('lf t55 detect')
    print(dash)
    print('all done!')

end

