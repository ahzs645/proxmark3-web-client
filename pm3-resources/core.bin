#!/usr/bin/env -S pm3 --offline -s

rem hello
rem world
#!/usr/bin/env -S pm3 -s

mem load -f mfc_default_keys --mfc
mem load -f t55xx_default_pwds --t55xx
mem load -f iclass_default_keys --iclass
mem load -f mfulc_default_keys --ulc
mem load -f mfulaes_default_keys --aes
lf t55xx deviceconfig --r0 -a 29 -b 17 -c 15 -d 47 -e 15 -p
msleep --ms 200
lf t55xx deviceconfig --r1 -a 29 -b 17 -c 18 -d 50 -e 15 -p
msleep --ms 200
lf t55xx deviceconfig --r2 -a 29 -b 17 -c 18 -d 40 -e 15 -p
msleep --ms 200
lf t55xx deviceconfig --r3 -a 29 -b 17 -c 15 -d 31 -e 15 -f 47 -g 63 -p
clear

rem  Test of Motorola clone & read
lf t55xx wipe
lf motorola clone --raw a0000000a0002021
lf motorola read
lf search

rem  Test of Nexwatch clone & read
lf t55xx wipe
lf nexwatch clone --cn 1337 -m 1 -n
lf nexwatch read
lf search

rem  Test of keri clone & read
lf t55xx wipe
lf keri clone --id 1337
lf keri read
lf search

rem  Test of Indala clone & read
lf t55xx wipe
lf indala clone --fc 7 --cn 1337
lf indala read
lf search

rem done, just wiping your tag.
lf t55xx wipe
#!/usr/bin/env -S pm3 -s
hw fpga config -f PM5_FPGA_fix_loedge_bug.bin
hf 14a read --drop

#!/usr/bin/env -S pm3 -s
hw fpga config -f PM5_FPGA_fix_loedge_bug.bin
hf 14a read --drop

hw bwm setcap --cap 500
hw bwm upgrade -f proxmark5_ble_wifi_module.bin

