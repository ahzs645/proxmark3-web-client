# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Raw hardware capture logs (working artifacts; bundled demo data lives in src/)
captures/
card-dumps/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Proxmark3 WebAssembly build artifacts.
# NOTE: proxmark3wasm/ is a submodule, so git never tracks its contents from
# here -- its own .gitignore governs that tree. Rules scoped to paths inside it
# are inert, and are deliberately not repeated: the submodule intentionally
# tracks vendored sources under client/deps/ (id48, openjpeg) that a blanket
# rule here would wrongly hide if the path ever stopped being a submodule.
*.o
*.a
*.bc
*.wasm
*.js.mem
*.js.symbols

# The built WASM client is committed and shipped by the Pages deploy, so it
# must survive the *.wasm rule above. Un-ignore the whole directory rather than
# individual filenames -- a renamed or added artifact would otherwise be
# silently dropped and break the deploy.
!public/wasm/**
